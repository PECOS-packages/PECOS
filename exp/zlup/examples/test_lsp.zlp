// Test file for zlups LSP
// Open this in Neovim to test diagnostics, hover, and completions

pub fn main() -> unit {
    q := qalloc(4);
    pz q;

    // Apply Hadamard gates
    h q[0];
    h q[1];

    // Create entanglement
    cx (q[0], q[2]);
    cx (q[1], q[3]);

    // Measure qubits
    r0: u1 = mz(u1) q[0];
    r1: u1 = mz(u1) q[1];

    // This line has an error - undefined function
    // Uncomment to test diagnostics:
    // undefined_func();

    return unit;
}

